{
  "name": "mini-rack-planner",
  "private": true,
  "version": "0.0.0",
  "description": "Plan 3D-printed 10-inch homelab racks: drag-and-drop layout, 2D/3D preview, and a bill of materials / shopping list.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "headers": "tsx scripts/headers.ts",
    "validate-catalog": "tsx scripts/validate-catalog.ts",
    "bom": "tsx scripts/bom.ts",
    "check-budgets": "tsx scripts/check-budgets.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@fontsource-variable/geist": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "fflate": "0.8.3",
    "hash-wasm": "4.12.0",
    "immer": "11.1.21",
    "lucide-react": "1.55.0",
    "meshoptimizer": "1.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5",
    "zundo": "2.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fast-check/vitest": "0.5.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
