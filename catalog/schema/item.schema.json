{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mini Rack Planner catalog: item or extra",
  "description": "A printed mount, panel, shelf or accessory, one file per item in catalog/items/<id>.json.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "item",
        "extra"
      ]
    },
    "id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(?:custom:)?[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "makerworld",
            "printables",
            "thingiverse",
            "github",
            "vendor",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "designer": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "platform",
        "url"
      ],
      "additionalProperties": false
    },
    "verified": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "method": {
          "type": "string",
          "enum": [
            "page",
            "user-files",
            "calipers",
            "vendor-spec",
            "unverified"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "date",
        "method"
      ],
      "additionalProperties": false
    },
    "heightSixths": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "faces": {
      "default": [
        "front"
      ],
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "front",
          "rear"
        ]
      }
    },
    "bay": {
      "default": "full",
      "type": "string",
      "enum": [
        "full",
        "half"
      ]
    },
    "depthMm": {
      "type": "number",
      "minimum": 0
    },
    "options": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "rack",
              "top",
              "bottom",
              "section",
              "item"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "boolean",
              "choice"
            ]
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "effects": {
                  "type": "object",
                  "properties": {
                    "depthMm": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "innerWidthMm": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "default": {
            "type": [
              "boolean",
              "string"
            ]
          },
          "effects": {
            "type": "object",
            "properties": {
              "depthMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "innerWidthMm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          },
          "help": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "scope",
          "kind",
          "default"
        ],
        "additionalProperties": false
      }
    },
    "prints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "plate": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "gramsPerPrint": {
            "type": "number",
            "minimum": 0
          },
          "minutesPerPrint": {
            "type": "number",
            "minimum": 0
          },
          "pieces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "partId": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "perPrint": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "partId",
                "perPrint"
              ],
              "additionalProperties": false
            }
          },
          "embeds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hardwareId": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^(?:custom:)?[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "perPrint": {
                  "type": "number",
                  "minimum": 0
                },
                "when": {
                  "$ref": "#/$defs/Condition"
                }
              },
              "required": [
                "hardwareId",
                "perPrint"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "plate",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "recipe": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "unit": {
            "type": "string",
            "enum": [
              "rack",
              "top",
              "bottom",
              "section",
              "joint",
              "item"
            ]
          },
          "ref": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "print": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  }
                },
                "required": [
                  "print"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "hardware": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^(?:custom:)?[a-z0-9]+(?:-[a-z0-9]+)*$"
                  }
                },
                "required": [
                  "hardware"
                ],
                "additionalProperties": false
              }
            ]
          },
          "count": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "object",
                "properties": {
                  "base": {
                    "type": "number",
                    "minimum": 0
                  },
                  "perU": {
                    "type": "number",
                    "minimum": 0
                  },
                  "perSection": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "maxLength": 100,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "perSectionAny": {
                    "type": "number",
                    "minimum": 0
                  },
                  "perJoint": {
                    "type": "number",
                    "minimum": 0
                  },
                  "jointFilter": {
                    "type": "object",
                    "properties": {
                      "notAdjacentTo": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 100,
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "length": {
            "type": "object",
            "properties": {
              "base": {
                "default": 0,
                "type": "number"
              },
              "perU": {
                "default": 0,
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "when": {
            "$ref": "#/$defs/Condition"
          },
          "role": {
            "default": "assembly",
            "type": "string",
            "enum": [
              "assembly",
              "rack-mount",
              "embedded"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "unit",
          "ref",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "mount": {
      "default": {
        "front": 0,
        "rear": 0
      },
      "type": "object",
      "properties": {
        "front": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rear": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "holeOffsetsMm": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "slotLengthMm": {
          "type": "number",
          "minimum": 0
        },
        "clearance": {
          "type": "string",
          "enum": [
            "M3",
            "M4",
            "M5",
            "M6",
            "10-32",
            "12-24"
          ]
        },
        "earThicknessMm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "front"
      ],
      "additionalProperties": false
    },
    "slots": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fixed",
              "area"
            ]
          },
          "maxW": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxD": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxH": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "orientations": {
            "default": [
              "flat",
              "flat-rotated"
            ],
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "flat",
                "flat-rotated",
                "on-side",
                "upright"
              ]
            }
          },
          "accepts": {
            "type": "object",
            "properties": {
              "categories": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "mini-pc",
                    "sbc",
                    "nas",
                    "drive",
                    "switch",
                    "router",
                    "gateway",
                    "pdu",
                    "ups",
                    "power-brick",
                    "kvm",
                    "patch-panel",
                    "other"
                  ]
                }
              },
              "deviceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^(?:custom:)?[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            },
            "additionalProperties": false
          },
          "layout": {
            "type": "object",
            "properties": {
              "xMm": {
                "type": "number"
              },
              "yMm": {
                "type": "number"
              },
              "zMm": {
                "type": "number"
              }
            },
            "required": [
              "xMm",
              "yMm",
              "zMm"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "maxW",
          "maxD",
          "layout"
        ],
        "additionalProperties": false
      }
    },
    "requiresRearSupport": {
      "type": "boolean"
    },
    "compat": {
      "type": "object",
      "properties": {
        "frames": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^(?:custom:)?[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "blank",
            "vent",
            "keystone",
            "shelf",
            "tray",
            "device",
            "fan",
            "power",
            "other"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6})$"
        }
      },
      "required": [
        "style"
      ],
      "additionalProperties": false
    },
    "parts3d": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "leg",
              "connector",
              "cap",
              "panel",
              "tray",
              "shelf",
              "plate",
              "other"
            ]
          },
          "envelopeMm": {
            "type": "object",
            "properties": {
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "d": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "w",
              "d",
              "h"
            ],
            "additionalProperties": false
          },
          "mirrorAllowed": {
            "type": "boolean"
          },
          "nameHints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "label",
          "role",
          "envelopeMm"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "id",
    "name",
    "category",
    "verified",
    "heightSixths",
    "depthMm"
  ],
  "$defs": {
    "Condition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "option": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": [
                      "string",
                      "boolean",
                      "number"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "boolean",
                        "number"
                      ]
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "option"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "stack": {
              "type": "object",
              "properties": {
                "minU": {
                  "type": "number",
                  "minimum": 0
                },
                "maxU": {
                  "type": "number",
                  "minimum": 0
                },
                "minSections": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maxSections": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "topTypeId": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "bottomTypeId": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "stack"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
