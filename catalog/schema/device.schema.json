{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mini Rack Planner catalog: device",
  "description": "Equipment such as a mini PC, switch or drive, one file per device in catalog/devices/<id>.json.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "device"
    },
    "id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(?:custom:)?[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "mini-pc",
        "sbc",
        "nas",
        "drive",
        "switch",
        "router",
        "gateway",
        "pdu",
        "ups",
        "power-brick",
        "kvm",
        "patch-panel",
        "other"
      ]
    },
    "dims": {
      "type": "object",
      "properties": {
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "d": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "w",
        "d",
        "h"
      ],
      "additionalProperties": false
    },
    "weightG": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "power": {
      "type": "object",
      "properties": {
        "typW": {
          "type": "number",
          "minimum": 0
        },
        "maxW": {
          "type": "number",
          "minimum": 0
        },
        "input": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "ac",
                "usb-c-pd",
                "poe",
                "dc",
                "none"
              ]
            },
            "connector": {
              "type": "string",
              "minLength": 1
            },
            "brick": {
              "type": "object",
              "properties": {
                "dims": {
                  "type": "object",
                  "properties": {
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "d": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "w",
                    "d",
                    "h"
                  ],
                  "additionalProperties": false
                },
                "outputW": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "included": {
                  "type": "boolean"
                },
                "plug": {
                  "type": "string",
                  "enum": [
                    "c5",
                    "c7",
                    "c13",
                    "wall"
                  ]
                }
              },
              "required": [
                "included"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "ac",
                  "poe",
                  "usb-c",
                  "dc"
                ]
              },
              "count": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "maxWEach": {
                "type": "number",
                "minimum": 0
              },
              "budgetW": {
                "type": "number",
                "minimum": 0
              },
              "batteryBacked": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "count"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    },
    "rackmount": {
      "type": "object",
      "properties": {
        "heightSixths": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "face": {
          "type": "string",
          "enum": [
            "front",
            "rear"
          ]
        },
        "depthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "heightSixths",
        "face",
        "depthMm"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "makerworld",
            "printables",
            "thingiverse",
            "github",
            "vendor",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "designer": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "platform",
        "url"
      ],
      "additionalProperties": false
    },
    "verified": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "method": {
          "type": "string",
          "enum": [
            "page",
            "user-files",
            "calipers",
            "vendor-spec",
            "unverified"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "date",
        "method"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "id",
    "brand",
    "model",
    "category",
    "dims",
    "verified"
  ],
  "additionalProperties": false
}
