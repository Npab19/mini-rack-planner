# Normalize line endings to LF in the repo regardless of OS (repo lives on Windows + OneDrive).
* text=auto eol=lf

*.sh   text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary assets — never touch line endings, never diff.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.wasm  binary

# Model files must never be committed (MakerWorld licences); kept here so accidental adds are binary-safe.
*.stl   binary
*.3mf   binary
*.step  binary
*.stp   binary
*.zip   binary
